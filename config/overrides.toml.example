# config/overrides.toml — the live-knob layer (managed by the control panel).
#
# You normally do NOT hand-edit this file. The web control panel writes it when you turn
# live knobs (like temperature, or a voice you're auditioning). Its values override
# config/active.toml every turn while they are set.
#
# It's shown here as an example so you know the shape and can read it to understand a
# "sticky" setting — e.g. a leftover [voice] section from a live audition will keep
# winning over your active.toml until it's cleared. When in doubt, clear it via the panel
# rather than editing by hand.
#
# Copy to config/overrides.toml (gitignored) only if you want to pre-seed overrides.
# Empty sections mean "no override" — the active.toml selection stands.

# Per-character reasoning/sampling overrides (how the character thinks).
[llm]
# temperature = 0.7

# Per-voice synthesis overrides (how the character sounds).
[voice]
# ref_wav = ""

[tts]
# (prosody knobs live here when set by the panel)

# Listening calibration overrides (how the mic/room is heard).
[vad]
# confidence = 0.7      # how sure the VAD must be a sound is speech (0.0–1.0)
# start_secs = 0.2      # sustained sound before "you started talking" (0.05–1.0)
# stop_secs = 0.5       # silence after speech before "you finished" (0.2–3.0)
# min_volume = 0.6      # loudness floor to count as speech (0.0–1.0)
