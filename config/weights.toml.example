# config/weights.toml — WHERE Hearth is willing to look for model weights.
#
# Copy to config/weights.toml in your data folder and edit. The file is optional:
# with no file at all Hearth uses the defaults below (no roots of your own, the
# product pointers on). A malformed file is a startup error naming this file.
#
# The two sentences that decide what this file is: Hearth ENROLLS weights, it does
# not store them — it keeps directories to look in and a resolved path per model,
# and it never downloads, moves, copies, or deletes a weights file. Nothing here
# makes Hearth depend on another program: the pointers below are paths to folders,
# and Hearth reads the files in them and their GGUF headers, never a product's
# daemon, command line, or private cache. Quit or uninstall any of them and a scan
# gives the same answer.
#
#   python -m hearth.weights roots     # what this file resolves to
#   python -m hearth.weights scan      # what is in those directories

[weights]

# Directories of your own, scanned recursively. `~` is expanded and symlinks are
# followed once, so what gets enrolled is always the real path. Order matters only
# in one way: the first root is where the landing folder defaults to.
# roots = ["/Users/<you>/models"]
roots = []

# Point at the folders the popular weights-serving products keep files in, when
# those folders exist:
#     ~/.lmstudio/models          <publisher>/<repo>/*.gguf
#     ~/.ollama/models            manifests/** -> blobs/sha256-*
#     ~/.cache/huggingface/hub    models--<org>--<repo>/snapshots/<rev>/*.gguf
# These are DIRECTORY POINTERS and nothing else. A pointer whose real path already
# sits inside one of your own roots is skipped rather than scanned twice (on a
# machine where those folders are symlinks into your models folder, they all are).
# Set false if you would rather name every directory yourself.
product_dirs = true

# Hearth's own landing folder — where you put weights that arrive from here on, so
# another program's library stops growing on Hearth's account. It is subdivided by
# role: llm/, tts/, stt/. Only llm/ is scanned today; the speech stages fetch their
# own models and will be enrolled when that lands. Defaults to <first root>/hearth.
# landing = "/Users/<you>/models/hearth"

# The door binary. Used for two read-only things: reading this machine's memory
# budget (`--list-devices`) and checking that every key in a model's [server] table
# is a flag this door actually accepts (`--help`). Defaults to the llama-server on
# your PATH, then /opt/homebrew/bin/llama-server.
# llama_server = "/opt/homebrew/bin/llama-server"

# ── the door itself ───────────────────────────────────────────────────────────
# Everything above is about WEIGHTS. This table is about the DOOR: the facts that
# would still be true if every model on the machine were replaced tomorrow. A
# model's own flags live in its `[server]` table (config/models/<model>/model.toml);
# these live here, once. `python -m hearth.weights render <model>` turns the two
# together with the model's enrolled `[weights]` path into a launchd unit, and
# `apply` puts that unit where launchd reads it.
#
# Uncomment to render a unit. With no table at all the defaults below apply.

# Declaring this table also gives you two BUILT-IN actuators — `door-unload` and
# `door-load`, the launchctl pair derived from the label, your uid and the unit path —
# which the launch page's Models card presses as Unload / Load. No serve.toml block
# needed; see config/serve.toml.example if you would rather write your own.

#[weights.door]

# The launchd label. It names the unit file too: ~/Library/LaunchAgents/<label>.plist.
#label = "com.hearth.llm"

# Where the door listens. Loopback unless you have a reason — this is an
# unauthenticated-by-default local service, and a key file (below) is the only
# thing between it and anyone else on the network.
#host = "127.0.0.1"
#port = 8080

# A PATH to the door's access key, never the key itself. It is passed straight to
# `--api-key-file` and is never opened, printed, or logged by Hearth.
#   openssl rand -hex 32 > config/llm-api-key && chmod 600 config/llm-api-key
#api_key_file = "/Users/<you>/hearth-data/config/llm-api-key"

# Threads for the door. Unset lets it decide.
#threads = 24

# How the weights are brought into memory — the door's own `--load-mode`:
#   auto (default) · none · mmap · mlock · mmap+mlock · dio
# `mlock` keeps the file resident rather than letting the system swap or compress
# it; `dio` reads it with DirectIO. This one flag replaces the deprecated
# `--mlock` / `--mmap` / `--direct-io` trio, and a unit still carrying those is
# reported as a `deprecated-form` difference by `render --diff`, not a real one.
#load_mode = "mlock"

# The door's own log. launchd's capture of stdout/stderr goes beside it, named
# <name>.launchd.log.
#log_file = "/Users/<you>/hearth-data/logs/llm-server.log"

# The door's built-in browser UI. Off renders `--no-webui`; there is no reason to
# serve a second chat interface next to your companion.
#webui = false

# Anything not modelled above, appended to the command line verbatim.
#args = []
