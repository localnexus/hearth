# config/serve.toml — the optional serve-facade gate.
#
# Hearth can expose one bearer-authed, OpenAI-compatible endpoint that other local
# clients can share. It is OFF by default: with this file absent or enabled=false,
# nothing loads and no socket opens — the appliance is byte-identical when off.
#
# Copy to config/serve.toml (gitignored — it references a secret) and set enabled=true
# to open the facade.

[serve]
enabled = false

# Loopback by default. If you ever expose this beyond the machine, front it with a
# private overlay network — NEVER bind 0.0.0.0.
host = "127.0.0.1"
port = 65001

# Bearer auth is ALWAYS on — there is no unauthenticated mode, so a later network bind
# can never become an accidental open door. `token_source` is a PATH to a token file
# (one line, chmod 600), never the token itself. Mint one, for example:
#   openssl rand -hex 32 > config/serve-token && chmod 600 config/serve-token
token_source = "config/serve-token"

# Upstream LLM endpoint (your OpenAI-compatible server, e.g. llama-server).
# lm_base_url = "http://127.0.0.1:8080/v1"

# Upstream speech server (mlx-audio) and the model ids sent to it.
# audio_base_url = "http://127.0.0.1:8555/v1"
# tts_model = "mlx-community/chatterbox-turbo-fp16"
# stt_model = "mlx-community/whisper-large-v3-turbo"

# Voice output: proxy speech synthesis using the active voice bundle, pinned
# server-side (client-supplied voice/model fields are ignored).
speech_enabled = true

# Voice input: transcribe client audio with the local speech-to-text model. Ships OFF;
# flip to true to opt in.
transcriptions_enabled = false

# Conversation tap: append each turn to a plaintext transcript. A relative directory lives
# inside the facade's companion directory (characters/<character>/transcripts/ under the
# data root — gitignored); an absolute path is used as given.
transcript_tap = true
transcript_dir = "transcripts"

# ── Pinned facade identity (optional) ─────────────────────────────────────────
# By default the facade snapshots config/active.toml at kickstart. Pin an identity
# here to make the facade always speak as one companion — its own voice, independent
# of who is live at the desk. Uncomment and set both fields.
#[serve.identity]
#character = "example"       # pinned facade character (independent of active.toml)
#voice = "default"          # pinned voice bundle for that character
#[serve.identity.tts]        # optional: pin synth knobs — win over the client body AND the live layer
#temperature = 0.8          # (the example values here == the engine's own defaults)
#top_p = 0.95
#top_k = 1000
#repetition_penalty = 1.2
#speed = 1.0                 # playback-rate multiplier (upstream mlx-audio)
#allow_tag_profiles = false  # may per-tag profiles overlay the pin? (never forwarded upstream)

# Client-declarable roster: character name → its voice bundle. Listed names join the
# pinned/active identity in GET /v1/models, so a client can pick from a roster.
#[serve.characters]
# example = "default"

# ── The daemon face (ADR 007) — off by default ────────────────────────────────
# With enabled = true the STANDALONE facade (`python -m hearth.serve`) also
# supervises the voice bot: POST /admin/bot/start|stop, GET /admin/state, POST
# /admin/daemon/restart, POST /admin/switch (switch companion: a registry-
# validated active.toml write, then LIVE at the bot's next turn boundary when
# every changed piece has a live path — else a supervised warm restart; the
# control panel's COMPANION switcher rides this), and a reverse proxy to the
# bot's control panel — all behind the same bearer (one door). The in-process
# attach never mounts this. Stop is warm: your LLM server is never touched.
#[serve.supervisor]
#enabled = true
#stop_grace_s = 15.0        # SIGINT → escalate wait (graceful-shutdown headroom)
#term_grace_s = 5.0         # SIGTERM → SIGKILL wait
#[serve.supervisor.env]     # extra env for the spawned bot (values never printed)
#LM_PROVIDER = "lmstudio"
#[serve.supervisor.watch.streamcore]  # extra watched externals on /admin/state (reachability only)
#url = "http://127.0.0.1:8080"
#[serve.supervisor.actuators.lm-unload]  # declared actuator: fixed argv, no shell, no runtime args;
#command = ["/path/to/lms", "unload", "--all"]  # output → DATA/logs/actuators/<name>.log (0600)
#timeout_s = 120.0            # overrun kills the command itself (never what it detached)
#note = "free the LLM server's models (explicit cold stop — warm stays the default)"
#probe_url = ""               # optional: reachability shown beside the actuator
